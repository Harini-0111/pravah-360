# Google Earth Engine Configuration
EARTHENGINE_PROJECT=your-gee-project-id

# Google Maps Platform / Weather API
# Obtain from: https://console.cloud.google.com/apis/credentials
# Required API: Weather API (Google Maps Platform)
GOOGLE_WEATHER_API_KEY=your-google-weather-api-key

# Copernicus Data Space Ecosystem (CDSE) Credentials
CDSE_USERNAME=your-cdse-email@domain.com
CDSE_PASSWORD=your-cdse-password
CDSE_CLIENT_ID=your-cdse-client-id
CDSE_CLIENT_SECRET=your-cdse-client-secret

# NASA Earthdata Login (for GPM IMERG)
NASA_EARTHDATA_USERNAME=your-earthdata-username
NASA_EARTHDATA_PASSWORD=your-earthdata-password

# Project Coordinates: Lower Godavari Basin, AP
STUDY_AREA_MIN_LON=81.0
STUDY_AREA_MAX_LON=82.8
STUDY_AREA_MIN_LAT=16.3
STUDY_AREA_MAX_LAT=17.9
TARGET_FLOOD_EVENT_START=2022-07-10
TARGET_FLOOD_EVENT_PEAK=2022-07-15
TARGET_FLOOD_EVENT_END=2022-07-22
